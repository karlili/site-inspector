# Postgres, shared by the admin server and every runner.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/site_inspector
# DATABASE_POOL_SIZE=10

# Screenshots: "local" (default) writes them under SCREENSHOT_DIR; "s3" uses an S3-compatible bucket.
STORAGE_DRIVER=local
# DATA_DIR=data
# SCREENSHOT_DIR=data/screenshots

# For STORAGE_DRIVER=s3. These values match the MinIO in docker-compose.yml.
# S3_BUCKET=site-inspector
# S3_PREFIX=
# S3_REGION=us-east-1
# S3_ENDPOINT=http://localhost:9000
# S3_FORCE_PATH_STYLE=true
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
#
# Cloudflare R2:  S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com  S3_REGION=auto
# Google Cloud:   S3_ENDPOINT=https://storage.googleapis.com  S3_REGION=auto  (HMAC keys)
# AWS S3:         leave S3_ENDPOINT unset; S3_REGION=<bucket region>
